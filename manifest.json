{
  "manifest_version": 3,
  "name": "PandaVoice AI",
  "version": "1.0",
  "description": "Voice-controlled ordering for foodpanda.pk, designed for visually impaired users.",
  "permissions": ["activeTab", "storage", "scripting", "tts", "offscreen"],
  "commands": {
    "toggle-mic": {
      "suggested_key": {
        "default": "Ctrl+Shift+L",
        "mac": "Command+Shift+L"
      },
      "description": "Toggle Voice Assistant (or say 'Hey AI' to activate)"
    }
  },
  "host_permissions": ["https://www.foodpanda.pk/*"],
  "background": {
    "service_worker": "background/background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.foodpanda.pk/*"],
      "js": ["utils/constants.js", "utils/logger.js", "content/page-readers.js", "content/content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
